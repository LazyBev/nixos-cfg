#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    symbols: (song: "♪", dir: "▸", playlist: "♫", marker: "▎"),
    browser_column_widths: [20, 38, 42],
    text_color: "#cdd6f4",
    background_color: "#1e1e2e",
    header_background_color: "#181825",
    modal_background_color: None,
    modal_backdrop: false,
    tab_bar: (active_style: (fg: "black", bg: "#cba6f7", modifiers: "Bold"), inactive_style: ()),
    borders_style: (fg: "#6c7086"),
    highlighted_item_style: (fg: "#cba6f7", modifiers: "Bold"),
    current_item_style: (fg: "black", bg: "#cba6f7", modifiers: "Bold"),
    highlight_border_style: (fg: "#cba6f7"),
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "#cba6f7"), default: (kind: Text("Unknown"))),
            width: "50%",
            alignment: Right,
        ),
        (
            prop: (kind: Text("-"), style: (fg: "#cba6f7"), default: (kind: Text("Unknown"))),
            width: "1",
            alignment: Center,
        ),
        (
            prop: (kind: Property(Title), style: (fg: "#89b4fa"), default: (kind: Text("Unknown"))),
            width: "50%",
        ),
    ],
    progress_bar: (
        symbols: ["━", "━", "●", " ", " "],
        track_style: (bg: "#181825"),
        elapsed_style: (fg: "#cba6f7", bg: "#181825"),
        thumb_style: (fg: "#cba6f7", bg: "#181825"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (),
        ends_style: (),
        thumb_style: (fg: "#cba6f7"),
    ),
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "30",
                            pane: Component("header_left"),
                        ),
                        (
                            size: "100%",
                            pane: Component("header_center"),
                        ),
                        (
                            size: "25",
                            pane: Component("header_right"),
                        ),
                    ],
                ),
                size: "2",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                pane: Pane(ProgressBar),
                size: "1",
            ),
        ],
    ),
    components: {
        "header_left": Split(
            direction: Vertical,
            panes: [
                (
                    size: "1",
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "#cba6f7", modifiers: "Bold")),
                        (kind: Property(Status(StateV2(
                            play_label: "▶", pause_label: "⏸", stop_label: "■",
                        ))), style: (fg: "#cba6f7", modifiers: "Bold")),
                        (kind: Text("]"), style: (fg: "#cba6f7", modifiers: "Bold")),
                        (kind: Text(" ")),
                        (kind: Property(Status(Elapsed)), style: (fg: "#a5adcb")),
                        (kind: Text(" / "), style: (fg: "#6c7086")),
                        (kind: Property(Status(Duration)), style: (fg: "#a5adcb")),
                    ], align: Left)),
                ),
            ],
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (
                    size: "1",
                    pane: Pane(Property(content: [
                        (kind: Property(Song(Artist)), style: (fg: "#eed49f", modifiers: "Bold"),
                            default: (kind: Text("Unknown"), style: (fg: "#eed49f", modifiers: "Bold"))),
                        (kind: Text(" - ")),
                        (kind: Property(Song(Title)), style: (fg: "#89b4fa", modifiers: "Bold"),
                            default: (kind: Text("No Song"), style: (fg: "#89b4fa", modifiers: "Bold"))),
                    ], align: Center)),
                ),
            ],
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (
                    size: "1",
                    pane: Pane(Property(content: [
                        (kind: Text("Vol: "), style: (fg: "#cba6f7", modifiers: "Bold")),
                        (kind: Property(Status(Volume)), style: (fg: "#cba6f7", modifiers: "Bold")),
                        (kind: Text("% "), style: (fg: "#cba6f7", modifiers: "Bold")),
                    ], align: Right)),
                ),
                (
                    size: "1",
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "#cba6f7", modifiers: "Bold")),
                        (kind: Property(Status(RepeatV2(
                            on_label: "z", off_label: "z",
                            on_style: (fg: "#cba6f7", modifiers: "Bold"),
                            off_style: (fg: "#6c7086"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x", off_label: "x",
                            on_style: (fg: "#cba6f7", modifiers: "Bold"),
                            off_style: (fg: "#6c7086"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c", off_label: "c", oneshot_label: "c",
                            on_style: (fg: "#cba6f7", modifiers: "Bold"),
                            off_style: (fg: "#6c7086"),
                            oneshot_style: (fg: "#ed8796", modifiers: "Bold"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v", off_label: "v", oneshot_label: "v",
                            on_style: (fg: "#cba6f7", modifiers: "Bold"),
                            off_style: (fg: "#6c7086"),
                            oneshot_style: (fg: "#ed8796", modifiers: "Bold"),
                        )))),
                        (kind: Text("]"), style: (fg: "#cba6f7", modifiers: "Bold")),
                    ], align: Right)),
                ),
            ],
        ),
    },
)
