(bar.create)
(bar.set-interval 0.5)
(bar.set-font "Monocraft" size 14)
(bar.set-background height 28 colour "#181825" font-color "#cdd6f4")
(bar.separator " " colour "#313244")
(bar.set-logo-size 0)
(bar.set-widget-gap 0)
(bar.pad left 6)
(bar.set-left workspaces)
(bar.set-center label colour "#cdd6f4" txt " " (!"date '+%b %d %Y  %H:%M'") colour "#cdd6f4")
(bar.set-right (cpu fmt "CPU {}") txt " " (memory fmt "MEM {}") txt " " (volume fmt "VOL {}") txt " " (battery fmt "BAT {}") txt " " (wifi fmt "{}"))
(bar.start)
