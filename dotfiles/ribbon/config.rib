(bar.create)
(bar.set-interval 0.5)
(bar.set-font "DejaVu Sans" size 14)
(bar.set-background height 28 colour "#0a0a0a" font-color "#e0e0e0")
(bar.separator " " colour "#2a2a2a")
(bar.set-logo-size 0)
(bar.set-widget-gap 0)
(bar.pad left 6)
(bar.set-left workspaces)
(bar.set-center label colour "#e0e0e0" txt " " (!"date '+%b %d %Y  %H:%M'") colour "#e0e0e0")
(bar.set-right (cpu fmt "CPU {}") txt " " (memory fmt "MEM {}") txt " " (volume fmt "VOL {}") txt " " (battery fmt "BAT {}") txt " " (wifi fmt "{}"))
(bar.start)
